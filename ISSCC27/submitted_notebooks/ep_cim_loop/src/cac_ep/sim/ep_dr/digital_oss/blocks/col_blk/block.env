# col_blk (열 주변, 반쪽마다 하나): col_ctrl RTL + 열 MUX·clamp 매크로 384 개. RTL·매크로·SDC·testbench 는 상용 판과 같은 파일 (digital/col_blk/)
TOP=col_blk
RTL="digital/col_blk/rtl/coll.v digital/col_blk/rtl/col_ctrl.v"
MACRO_VH=digital/col_blk/col_macros.vh
XLEF="digital/col_blk/macros/cb_tg_n2.lef digital/col_blk/macros/cb_tgw_n20.lef digital/col_blk/macros/clamp_d2r.lef"
XGDS="digital/col_blk/macros/cb_tg_n2.gds digital/col_blk/macros/cb_tgw_n20.gds digital/col_blk/macros/clamp_d2r.gds"
XCDL="digital/col_blk/macros/cb_tg_n2.cdl digital/col_blk/macros/cb_tgw_n20.cdl digital/col_blk/macros/clamp_d2r.cdl"
SDC=digital/col_blk/col_blk.sdc
TB="digital/col_blk/tb/ref_coll.v digital/col_blk/tb/tb_col_blk.v"
TBPASS="TB_BLK: PASS"
DENS=0.80
REPAIR=0
CLEAR_PINS="^(sdi|rstb|col1_clk|col2_clk|sel_en|PROG|VER|SENSE|WRANY|READ|READb)$"

# row_blk (행 주변, 반쪽마다 하나): row_ctrl RTL + 행 MUX 매크로 636 개. RTL·매크로·SDC·testbench 는 상용 판과 같은 파일 (digital/row_blk/)
TOP=row_blk
RTL="digital/row_blk/rtl/rowl.v digital/row_blk/rtl/row_ctrl.v"
MACRO_VH=digital/row_blk/rowm.json
XLEF="digital/row_blk/macros/rb_macros.lef"
XGDS="digital/row_blk/macros/rb_macros.gds"
XCDL="digital/row_blk/macros/rb_macros.cdl"
SDC=digital/row_blk/row_blk.sdc
TB="digital/row_blk/tb/rb_macro_stubs.v digital/row_blk/tb/ref_rowl.v digital/row_blk/tb/tb_row_blk.v"
TBPASS="TB_ROW: PASS"
DENS=0.60
REPAIR=0
CLEAR_PINS="^(sdi|rstb|row1_clk|row2_clk|sel_en|PROG|VER|SENSE|READb|WRANY|vw|vwl|vzero|R1|R2)$"

n5:e -> c19:p18:w [color="black", fontcolor="black", label=""];
c17:p16:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c19:p9:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n7:e -> c17:p13:w [color="black", fontcolor="black", label=""];
n8:e -> c12:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];

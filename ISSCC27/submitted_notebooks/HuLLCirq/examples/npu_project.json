    },
    {
      "id": "node-buffer",
      "name": "A / B input buffers",
      "module_name": "hullcirq_buffer",
      "parent_id": null,
      "behavior": "Store A[4,K] and B[K,4] as signed INT8 in registers (maximum 128 bytes, no SRAM). load_data is a 16-bit addressed byte-write packet; read_request identifies one A and one B address, read_response packs A in low8 and B in high8. Stall responses without losing their request. Detailed address encoding and global port expansion remain planned.",
      "test_expectations": "Required system tests are the GUI-saved matrix job and its per-node projections. Functional evidence is only claimed for stages that actually execute. Hold valid/data under stalls, reset cancels pending transfers, and preserve job/result ordering.",
      "constraints": {
        "latency_cycles": 1,
        "protocol": "valid_ready"
      },
      "ports": [
        {
          "id": "port-buffer-load_data",
          "name": "load_data",
          "direction": "input",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {
          "id": "port-buffer-read_request",
          "name": "read_request",
          "direction": "input",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {
          "id": "port-buffer-read_response",
          "name": "read_response",
          "direction": "output",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        }
      ]
    },
    {
      "id": "node-scheduler",
      "name": "Array scheduler",
      "module_name": "hullcirq_scheduler",
      "parent_id": null,
      "behavior": "For each configured matrix job, schedule the K operand pairs for each of 16 output-stationary PE instances. Pair low8 is signed A[m,k]; high8 is signed B[k,n]. Only count accepted valid/ready transfers, clear PEs at job boundaries and preserve row-major final-result order. Edges to the PE template represent an intended 16-lane expansion during global integration, which is not implemented in this revision.",
      "test_expectations": "Required system tests are the GUI-saved matrix job and its per-node projections. Functional evidence is only claimed for stages that actually execute. Hold valid/data under stalls, reset cancels pending transfers, and preserve job/result ordering.",
      "constraints": {
        "latency_cycles": 1,
        "protocol": "valid_ready"
      },
      "ports": [
        {
          "id": "port-scheduler-schedule_config",
          "name": "schedule_config",
          "direction": "input",
          "width": 134,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {

    {
      "id": "node-control",
      "name": "Job control",
      "module_name": "hullcirq_control",
      "parent_id": null,
      "behavior": "Accept one configuration/job at a time. Job configuration contains K (1..16), four signed INT32 column biases and ReLU enable. Keep configuration stable while busy, reject overlapping starts and report completion only after the final output transfer. Global integration must clear all PE accumulators at each job boundary. Detailed integration is planned; no control RTL is currently generated.",
      "test_expectations": "Required system tests are the GUI-saved matrix job and its per-node projections. Functional evidence is only claimed for stages that actually execute. Hold valid/data under stalls, reset cancels pending transfers, and preserve job/result ordering.",
      "constraints": {
        "latency_cycles": 1,
        "protocol": "valid_ready"
      },
      "ports": [
        {
          "id": "port-control-config_data",
          "name": "config_data",
          "direction": "input",
          "width": 134,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {
          "id": "port-control-schedule_config",
          "name": "schedule_config",
          "direction": "output",
          "width": 134,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {

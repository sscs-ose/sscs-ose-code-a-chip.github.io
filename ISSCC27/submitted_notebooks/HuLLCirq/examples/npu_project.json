          "name": "read_request",
          "direction": "output",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {
          "id": "port-scheduler-read_response",
          "name": "read_response",
          "direction": "input",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        },
        {
          "id": "port-scheduler-pair_data",
          "name": "pair_data",
          "direction": "output",
          "width": 16,
          "signed": false,
          "protocol": "valid_ready",
          "clock": "clk",
          "reset": "rst"
        }
      ]
    },
    {
      "id": "node-pe",
      "name": "INT8 PE template",
      "module_name": "hullcirq_pe",
      "parent_id": null,
      "behavior": "Single PE implementation intended for reuse across the 4x4 output-stationary array. Synchronous active-high rst clears signed INT32 accumulator, acc_data and acc_data_valid to zero. pair_data low8 is signed INT8 a and high8 is signed INT8 b. pair_data_ready = !acc_data_valid || acc_data_ready, including during reset. On each non-reset rising clk input handshake, compute signed8* signed8 (16-bit signed product), add it with sign extension to the accumulator modulo 2^32, and publish the new accumulator on acc_data with valid=1. Output-only handshake clears valid while retaining accumulator/data. Simultaneous input/output handshakes replace the consumed output with the new sum. During output backpressure, hold acc_data and valid and do not consume input. Reset has highest priority. No initial values or extra ports. Global integration must drive this rst at each job boundary; that integration remains planned.",
      "test_expectations": "Executable PE verification uses the 42 GUI-saved cycles in verification.vectors, projected from row0 of the saved K=4 matrix job across all four columns. Each column begins with reset. Check mixed signs and INT8 extrema, acceptance into an empty output while downstream is stalled, output/data hold, rejected inputs during stalls, simultaneous consume/replace, output-only clearing, accumulator retention, and reset priority. This finite projection does not verify the complete NPU, K=1/16, long-run INT32 wraparound, bias/ReLU or FIFO.",
      "constraints": {
        "latency_cycles": 1,
        "protocol": "valid_ready"
      },
      "ports": [
        {
          "id": "port-pe-pair_data",
          "name": "pair_data",

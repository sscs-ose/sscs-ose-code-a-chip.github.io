** sch_path: /home/satancci/vco/vco.v2/schematics/sym/tb_vco_v1.sch
**.subckt tb_vco_v1
V1 VDD GND 1.8
V2 ai_vco GND 0
x1 ao_vco ai_vco GND VDD vco
**** begin user architecture code



.lib /usr/local/share/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice tt

.ic v(ao_vco) = 0
.option method=gear

.control
  reset
  alter V2 0.00
  tran 0.1p 2n
  meas tran T trig v(ao_vco) val=0.9 rise=2 targ v(ao_vco) val=0.9 rise=3
  let freq = 1 / T
  print freq


  write tb_vco_v1.raw v(ao_vco)
  wrdata tb_vco_v1.csv v(ao_vco)

  alter V2 1.8
  tran 0.1p 2n
  meas tran T trig v(ao_vco) val=0.9 rise=2 targ v(ao_vco) val=0.9 rise=3
  let freq = 1 / T
  print freq

  save all

.endc


.end


**** end user architecture code
**.ends


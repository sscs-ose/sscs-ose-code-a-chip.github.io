   "source": [
    "op = lab.load_op(CASE, DATA)\n",
    "geometry = op[['name','drain','gate','source','body','kind','width_um','length_um','multiplicity']].copy()\n",
    "geometry.columns = ['Device','Drain','Gate','Source','Body','Model family','W (µm)','L (µm)','Units']\n",
    "display(geometry)\n",
    "bias = op[['name','id','gm','ro_ohm','vgs','vds','margin_v']].copy()\n",
    "bias['id'] *= 1e6\n",
    "bias['gm'] *= 1e3\n",
    "bias.columns = ['Device','Current (µA)','gm (mS)','ro (Ω)','Vgs magnitude (V)','Vds magnitude (V)','Saturation margin (V)']\n",
    "display(bias.round(5))\n",
    "full = nominal.loc[np.isclose(nominal.load_mA, 50)].iloc[0]\n",
    "efficiency = full.output_V * .05 / (1.2 * full.VIN_current_mA * 1e-3 + 1.8 * full.VAA_current_uA * 1e-6)\n",
    "print(f'Nominal full load power efficiency: {100*efficiency:.2f}%')\n"
   ]

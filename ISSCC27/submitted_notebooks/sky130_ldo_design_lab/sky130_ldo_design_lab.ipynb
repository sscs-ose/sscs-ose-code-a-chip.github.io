    "            axes[row,column].semilogx(curve.frequency_hz, curve.magnitude_db, label=f'{cap} pF')\n",
    "    for column, name in enumerate(('VIN','VAA')):\n",
    "        axes[row,column].set(title=f'{name}, {load} mA', ylabel='Supply transfer (dB)', xlim=(1e3,1e9))\n",

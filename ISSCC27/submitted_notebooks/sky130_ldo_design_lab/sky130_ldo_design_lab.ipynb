    "fig, axes = plt.subplots(2, 1, figsize=(10, 7), sharex=True, constrained_layout=True)\n",
    "for case in record['nominal_cases']:\n",
    "    current = lab.load_circuit(case, DATA)['load_a']*1000\n",
    "    for axis, source in zip(axes, ('power','auxiliary')):\n",
    "        curve = lab.load_ac(case, source, data_dir=DATA)\n",
    "        axis.semilogx(curve.frequency_hz, curve.magnitude_db, label=f'{current:g} mA')\n",
    "for axis, title in zip(axes, ('VIN ripple transfer', 'VAA ripple transfer')):\n",
    "    axis.set(title=title, ylabel='Supply transfer (dB)', xlim=(1, 1e9))\n",
    "    axis.grid(alpha=.25)\n",
    "axes[0].legend(ncol=3, fontsize=9)\n",
    "axes[-1].set_xlabel('Frequency (Hz)')\n",
    "plt.show()\n",
    "\n",
    "frequencies = [1e3, 1e4, 1e5, 1e6, 1e8, 1e9]\n",
    "rows = []\n",
    "for load in (0, 50):\n",
    "    for source, name in [('power','VIN'),('auxiliary','VAA')]:\n",
    "        curve = lab.load_ac(f'tied_load{load}mA_cout100pF', source, data_dir=DATA)\n",
    "        rows.append({'Load (mA)':load, 'Source':name,\n",
    "                     **{f'{f:g} Hz (dB)':np.interp(np.log10(f), np.log10(curve.frequency_hz), curve.magnitude_db)\n",
    "                        for f in frequencies}})\n",
    "display(pd.DataFrame(rows).round(2))\n"
   ]

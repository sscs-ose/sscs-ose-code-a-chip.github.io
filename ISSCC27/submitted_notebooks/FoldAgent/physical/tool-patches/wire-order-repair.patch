+TEST_F(TestOrderWires, SeparateExtensionsAtCorner)
+{
+  const InputBumpNet pins = buildInputBumpNet();
+  dbTechLayer* layer = db_->getTech()->findLayer("metal1");
+  dbWire* wire = dbWire::create(pins.net);
+  const int x = pins.bump_x - 2000;
+  const int y = pins.receiver_y;
+  const int half = layer->getWidth() / 2;
+  dbWireEncoder encoder;
+  encoder.begin(wire);
+  encoder.newPath(layer, dbWireType::ROUTED);
+  encoder.addPoint(pins.bump_x, y);
+  encoder.addPoint(x, y, 0);
+  encoder.newPath(layer, dbWireType::ROUTED);
+  encoder.addPoint(x, y);
+  encoder.addPoint(x, y + 2000);
+  encoder.addPoint(pins.receiver_x, y + 2000);
+  encoder.addPoint(pins.receiver_x, pins.receiver_y);
+  encoder.end();
+  const auto contains_corner = [&]() {
+    dbWireShapeItr shapes;
+    dbShape shape;
+    shapes.begin(pins.net->getWire());
+    while (shapes.next(shape)) {
+      if (!shape.isVia() && shape.getTechLayer() == layer
+          && shape.xMin() <= x - half / 2
+          && shape.xMax() >= x - half / 2
+          && shape.yMin() <= y - half / 2
+          && shape.yMax() >= y - half / 2) {
+        return true;
+      }
+    }
+    return false;
+  };
+  ASSERT_TRUE(contains_corner());
+  orderWires(&logger_, block_);
+  EXPECT_TRUE(pins.net->isWireOrdered());
+  EXPECT_TRUE(contains_corner());
+}

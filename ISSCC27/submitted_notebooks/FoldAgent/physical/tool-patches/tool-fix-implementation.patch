+// Cover both NDR storage scopes and both via encodings across layer changes.
+TEST_F(OdbMultiPatternedTest, NdrViaLayerWidthsAndDefaultBranches)
+{
+  dbTech* tech = lib_->getTech();
+  auto* met1 = tech->findLayer("met1");
+  auto* met2 = tech->findLayer("met2");
+  auto* tech_via = tech->findVia("M1M2_PR_MR");
+  ASSERT_NE(tech_via, nullptr);
+  met1->setWrongWayWidth(200);
+  auto* block_via = dbVia::create(block_, "block_via");
+  for (auto* box : tech_via->getBoxes()) {
+    dbBox::create(block_via, box->getTechLayer(), box->xMin(), box->yMin(),
+                  box->xMax(), box->yMax());
+  }
+  for (bool block_rule : {false, true}) {
+    for (bool use_block_via : {false, true}) {
+      const auto name = std::string("ndr_") + (block_rule ? "b" : "t")
+                        + (use_block_via ? "b" : "t");
+      auto* ndr = block_rule ? dbTechNonDefaultRule::create(block_, name.c_str())
+                             : dbTechNonDefaultRule::create(tech, name.c_str());
+      auto* r1 = dbTechLayerRule::create(ndr, met1);
+      auto* r2 = dbTechLayerRule::create(ndr, met2);
+      r1->setWidth(420);
+      r2->setWidth(840);
+      auto* net = dbNet::create(block_, name.c_str());
+      auto* wire = dbWire::create(net);
+      dbWireEncoder encoder;
+      encoder.begin(wire);
+      auto add_via = [&]() {
+        if (use_block_via) {
+          encoder.addVia(block_via);
+        } else {
+          encoder.addTechVia(tech_via);
+        }
+      };
+      encoder.newPath(met1, dbWireType::ROUTED, r1);
+      encoder.addPoint(0, 0);
+      const int junction = encoder.addPoint(0, 10000);
+      add_via();
+      encoder.addPoint(0, 20000);
+      add_via();
+      encoder.addPoint(0, 30000);
+      encoder.newPath(junction);
+      encoder.addPoint(0, 40000);
+      add_via();
+      encoder.addPoint(0, 50000);
+      encoder.newPath(met1, dbWireType::ROUTED);
+      encoder.addPoint(10000, 0);
+      encoder.addPoint(10000, 10000);
+      encoder.end();
+      std::vector<int> widths;
+      dbWireShapeItr itr;
+      dbShape shape;
+      itr.begin(wire);
+      while (itr.next(shape)) {
+        if (!shape.isVia()) {
+          widths.push_back(shape.getBox().minDXDY());
+        }
+      }
+      EXPECT_EQ(widths, (std::vector<int>{420, 840, 420, 200,
+                                        static_cast<int>(met2->getWidth()), 200}));
+    }
+  }
+}

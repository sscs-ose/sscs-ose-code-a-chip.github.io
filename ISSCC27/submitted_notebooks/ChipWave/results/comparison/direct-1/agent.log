{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport os, signal, subprocess\nrows = subprocess.check_output(['ps', '-eo', 'pid,pgid,args'], text=True).splitlines()\nfor row in rows:\n    fields = row.split(None, 2)\n    if len(fields) == 3 and fields[2].startswith('perl ') and '--lint-only --Wall --top-module nebula_npu_dot4 rtl/nebula_npu_dot4.sv' in fields[2]:\n        group = int(fields[1])\n        assert group \"'!= os.getpgrp()\n        print('\"'Stopping recursive Verilator process group', group)\n        os.killpg(group, signal.SIGKILL)\n        break\nelse:\n    print('No active lint parent found')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

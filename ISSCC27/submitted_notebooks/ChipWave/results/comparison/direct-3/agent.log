{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nPath('build/stress_tb.sv').write_text('''\"'`timescale 1ns/1ps\nmodule stress_tb;\n    logic clk=0, rst_n=0, req_valid=0, req_ready;\n    logic [31:0] req_a=0, req_b=0, rsp_data;\n    logic rsp_valid, rsp_ready=0, kill=0;\n    nebula_npu_dot4 dut(.*);\n    always #5 clk = ~clk;\n    bit busy=0;\n    integer due=0, expected=0, cycle, lane;\n    integer accepted=0, delivered=0, canceled=0, stalled=0;\n    integer kills[0:2];\n    integer seed=37, discard;\n    logic signed [7:0] a_lane, b_lane;\n    initial begin\n        for (lane=0; lane<3; lane=lane+1) kills[lane]=0;\n        discard=$urandom(seed);\n        repeat(2) begin @(posedge clk); #1; end\n        for(cycle=0; cycle<10000; cycle=cycle+1) begin\n            @(negedge clk);\n            req_a=$urandom; req_b=$urandom;\n            req_valid=($urandom_range(0,3)!=0);\n            rsp_ready=($urandom_range(0,2)!=0);\n            kill=($urandom_range(0,11)==0);\n            rst_n=($urandom_range(0,34)!=0);\n            #1;\n            if(req_ready !== (rst_n && !kill && !busy))\n                $fatal(1,\"ready cycle=%0d\",cycle);\n            if(rsp_valid !== (rst_n && !kill && busy && cycle-1>=due))\n                $fatal(1,\"pre-edge valid cycle=%0d\",cycle);\n            if((!rst_n || kill) && rsp_data !== 32'\"'b0)\n                \"'$fatal(1,\"cancellation output cycle=%0d\",cycle);\n            @(posedge clk);\n            if(!rst_n || kill) begin\n                if(busy) begin\n                    canceled=canceled+1;\n                    if(kill) begin\n                        if(cycle>=due) kills[2]=kills[2]+1;\n                        else if(cycle==due-1) kills[1]=kills[1]+1;\n                        else kills[0]=kills[0]+1;\n                    end\n                end\n                busy=0;\n            end else if(busy) begin\n                if(cycle-1>=due && rsp_ready) begin\n                    busy=0;\n                    delivered=delivered+1;\n                end else if(cycle-1>=due) stalled=stalled+1;\n            end else if(req_valid) begin\n                busy=1; due=cycle+2; expected=0;\n                accepted=accepted+1;\n                for(lane=0; lane<4; lane=lane+1) begin\n                    a_lane=req_a[lane*8 +: 8];\n                    b_lane=req_b[lane*8 +: 8];\n                    expected=expected + a_lane*b_lane;\n                end\n            end\n            #1;\n            if(rsp_valid !== (rst_n && !kill && busy && cycle>=due))\n                $fatal(1,\"latency cycle=%0d\",cycle);\n            if(req_ready !== (rst_n && !kill && !busy))\n                $fatal(1,\"post-edge ready cycle=%0d\",cycle);\n            if(rsp_valid && rsp_data !== expected)\n                $fatal(1,\"data cycle=%0d got=%h expected=%h\",cycle,rsp_data,expected);\n        end\n        if(accepted<100 || delivered<100 || canceled<100 || stalled<100)\n            $fatal(1,\"insufficient traffic coverage\");\n        if(kills[1]==0 || kills[2]==0)\n            $fatal(1,\"missing kill coverage\");\n        $display(\"NPU_STRESS_PASS accepted=%0d delivered=%0d canceled=%0d stalled=%0d\",accepted,delivered,canceled,stalled);\n        $finish;\n    end\nendmodule\n'\"''')\nPY\niverilog -g2012 -s stress_tb -o build/stress rtl/nebula_npu_dot4.sv build/stress_tb.sv\nvvp build/stress\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

  wb_v' = mem_advance
  wb_pc' = priority {
    mem_advance -> mem_pc
    else -> 0
  }
  wb_insn' = priority {
    mem_advance -> mem_insn
    else -> 0
  }
  wb_fault' = priority {
    mem_advance -> mem_fault || mem_error
    else -> 0
  }
  wb_cause' = priority {

    commit_rd: commit_rd
    commit_wdata: commit_wdata
    commit_mem_addr: commit_mem_addr
    commit_mem_wstrb: commit_mem_wstrb
    commit_mem_wdata: commit_mem_wdata
    trap_valid: trap_valid
    trap_pc: trap_pc
    trap_cause: trap_cause
    trap_tval: trap_tval
    rf0: rf0
    rf1: rf1
    rf2: rf2
    rf3: rf3

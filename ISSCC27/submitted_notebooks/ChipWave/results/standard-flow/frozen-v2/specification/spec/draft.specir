  ex_b_snap' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> id_rf2
    ex_v && ex_uses_b && wb_rf_write && ex_rs2 == wb_rd -> wb_result
    else -> hold
  }
  xdot_issued' = priority {
    npu_kill || ex_advance -> 0
    np_req_fire -> 1
    else -> hold
  }
  let ex_result: u32 = ex_xdot ? np_rsp_data : ex_lui ? ex_imm_u : ex_auipc ? ex_pc + ex_imm_u : ex_jal || ex_jalr ? ex_pc + 4 : ex_csr ? ex_csr_old : ex_alu
  mem_v' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> 1
    mem_advance -> 0
    else -> hold
  }
  mem_pc' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_pc
    else -> hold
  }
  mem_insn' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_insn
    else -> hold
  }
  mem_fault' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_final_fault
    else -> hold
  }
  mem_cause' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_final_cause
    else -> hold
  }
  mem_tval' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_final_tval
    else -> hold
  }
  mem_rd' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_rd
    else -> hold
  }
  mem_rd_write' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_rd_intent && !ex_final_fault
    else -> hold
  }
  mem_result' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_result
    else -> hold
  }
  mem_store' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_store && !ex_final_fault
    else -> hold
  }
  mem_load' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_load && !ex_final_fault
    else -> hold
  }
  mem_ea' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_ea
    else -> hold
  }
  mem_f3' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_f3
    else -> hold
  }
  mem_bus_addr' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_bus_addr
    else -> hold
  }
  mem_bus_data' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_bus_data
    else -> hold
  }
  mem_bus_mask' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_bus_mask
    else -> hold
  }
  mem_csr_write' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_csr_wintent && !ex_final_fault
    else -> hold
  }
  mem_csr_addr' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_csr_addr
    else -> hold
  }
  mem_csr_new' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_csr_new
    else -> hold
  }
  mem_mret' = priority {
    wb_flush || mem_error -> 0
    ex_advance -> ex_mret && !ex_final_fault
    else -> hold

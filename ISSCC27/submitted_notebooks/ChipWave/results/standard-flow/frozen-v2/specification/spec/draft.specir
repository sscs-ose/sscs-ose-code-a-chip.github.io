module nebula_npu_dot4 {
  in clk: bit
  in rst_n: bit
  in req_valid: bit
  out req_ready: bit
  in req_a: u32
  in req_b: u32
  out rsp_valid: bit
  in rsp_ready: bit
  out rsp_data: u32
  in kill: bit
  domain core = posedge clk, async reset !rst_n
  state phase: {IDLE,P0,P1,RSP} @core reset IDLE
  state p0: s16 @core reset 0
  state p1: s16 @core reset 0
  state p2: s16 @core reset 0
  state p3: s16 @core reset 0
  state pair0: s17 @core reset 0
  state pair1: s17 @core reset 0
  state result: s32 @core reset 0
  req_ready = rst_n && !kill && phase == IDLE
  rsp_valid = rst_n && !kill && phase == RSP
  rsp_data = rst_n ? as_u(result) : 0
  let req_fire: bit = req_valid && req_ready
  let rsp_fire: bit = rsp_valid && rsp_ready
  phase' = priority {
    kill -> IDLE
    req_fire -> P0
    phase == P0 -> P1
    phase == P1 -> RSP
    rsp_fire -> IDLE
    else -> hold
  }
  p0' = priority {
    kill -> 0
    req_fire -> sext(as_s(req_a[7:0]), 16) * sext(as_s(req_b[7:0]), 16)
    else -> hold
  }
  p1' = priority {
    kill -> 0
    req_fire -> sext(as_s(req_a[15:8]), 16) * sext(as_s(req_b[15:8]), 16)
    else -> hold
  }
  p2' = priority {
    kill -> 0
    req_fire -> sext(as_s(req_a[23:16]), 16) * sext(as_s(req_b[23:16]), 16)
    else -> hold
  }
  p3' = priority {
    kill -> 0
    req_fire -> sext(as_s(req_a[31:24]), 16) * sext(as_s(req_b[31:24]), 16)
    else -> hold
  }
  pair0' = priority {
    kill -> 0
    phase == P0 -> sext(p0, 17) + sext(p1, 17)
    else -> hold
  }
  pair1' = priority {
    kill -> 0
    phase == P0 -> sext(p2, 17) + sext(p3, 17)
    else -> hold
  }
  result' = priority {
    kill -> 0
    phase == P1 -> sext(sext(pair0, 18) + sext(pair1, 18), 32)
    else -> hold
  }
  assert @core req_fire |=> phase == P0 unless !rst_n || kill
  assert @core phase == P0 |=> phase == P1 unless !rst_n || kill
  assert @core phase == P1 |=> phase == RSP unless !rst_n || kill
  assert @core rsp_valid && !rsp_ready |=> rsp_valid && rsp_data == past(rsp_data, 1) unless !rst_n || kill
  assert @core always !(req_ready && rsp_valid) unless !rst_n || kill
}

module rv32i_five_stage_cpu(ENABLE_XNEBULA: int = 0) {
  in clk: bit
  in rst_n: bit
  out imem_valid: bit
  out imem_addr: u32
  in imem_rdata: u32
  out dmem_req_valid: bit
  in dmem_req_ready: bit
  out dmem_req_write: bit
  out dmem_req_addr: u32
  out dmem_req_wdata: u32
  out dmem_req_wstrb: u4
  in dmem_rsp_valid: bit
  out dmem_rsp_ready: bit
  in dmem_rsp_rdata: u32
  in dmem_rsp_err: bit
  out state commit_valid: bit @core reset 0
  out state commit_pc: u32 @core reset 0
  out state commit_insn: u32 @core reset 0
  out state commit_rd: u5 @core reset 0
  out state commit_wdata: u32 @core reset 0

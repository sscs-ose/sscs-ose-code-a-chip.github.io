  state mem_insn: u32 @core reset 0
  state mem_fault: bit @core reset 0
  state mem_cause: u32 @core reset 0
  state mem_tval: u32 @core reset 0
  state wb_v: bit @core reset 0
  state wb_pc: u32 @core reset 0
  state wb_insn: u32 @core reset 0
  state wb_fault: bit @core reset 0
  state wb_cause: u32 @core reset 0
  state wb_tval: u32 @core reset 0
  state ex_a_snap: u32 @core reset 0
  state ex_b_snap: u32 @core reset 0
  state mem_rd: u5 @core reset 0
  state mem_rd_write: bit @core reset 0
  state mem_result: u32 @core reset 0
  state mem_store: bit @core reset 0
  state mem_bus_addr: u32 @core reset 0
  state mem_bus_data: u32 @core reset 0
  state mem_bus_mask: u4 @core reset 0
  state mem_csr_write: bit @core reset 0
  state mem_csr_addr: u12 @core reset 0
  state mem_csr_new: u32 @core reset 0
  state mem_mret: bit @core reset 0
  state wb_rd: u5 @core reset 0
  state wb_rd_write: bit @core reset 0
  state wb_result: u32 @core reset 0
  state wb_store: bit @core reset 0
  state wb_bus_addr: u32 @core reset 0
  state wb_bus_data: u32 @core reset 0
  state wb_bus_mask: u4 @core reset 0
  state wb_csr_write: bit @core reset 0
  state wb_csr_addr: u12 @core reset 0
  state wb_csr_new: u32 @core reset 0
  state wb_mret: bit @core reset 0
  state mem_load: bit @core reset 0
  state mem_ea: u32 @core reset 0
  state mem_f3: u3 @core reset 0
  state mem_sent: bit @core reset 0
  state xdot_issued: bit @core reset 0
  state rf0: u32 @core reset 0
  state rf1: u32 @core reset 0
  state rf2: u32 @core reset 0
  state rf3: u32 @core reset 0
  state rf4: u32 @core reset 0
  state rf5: u32 @core reset 0
  state rf6: u32 @core reset 0
  state rf7: u32 @core reset 0
  state rf8: u32 @core reset 0
  state rf9: u32 @core reset 0
  state rf10: u32 @core reset 0
  state rf11: u32 @core reset 0
  state rf12: u32 @core reset 0
  state rf13: u32 @core reset 0
  state rf14: u32 @core reset 0
  state rf15: u32 @core reset 0
  state rf16: u32 @core reset 0
  state rf17: u32 @core reset 0
  state rf18: u32 @core reset 0
  state rf19: u32 @core reset 0
  state rf20: u32 @core reset 0
  state rf21: u32 @core reset 0
  state rf22: u32 @core reset 0
  state rf23: u32 @core reset 0
  state rf24: u32 @core reset 0
  state rf25: u32 @core reset 0
  state rf26: u32 @core reset 0
  state rf27: u32 @core reset 0
  state rf28: u32 @core reset 0
  state rf29: u32 @core reset 0
  state rf30: u32 @core reset 0
  state rf31: u32 @core reset 0
  state mstatus: u32 @core reset 32'h1800
  state mtvec: u32 @core reset 32'h80000000
  state mscratch: u32 @core reset 0
  state mepc: u32 @core reset 0
  state mcause: u32 @core reset 0
  state mtval: u32 @core reset 0
  let id_word: u32 = if_held ? if_word : imem_rdata
  let id_op: u7 = as_u(id_word[6:0])
  let id_f3: u3 = as_u(id_word[14:12])
  let id_f7: u7 = as_u(id_word[31:25])
  let id_rs1: u5 = as_u(id_word[19:15])
  let id_rs2: u5 = as_u(id_word[24:20])
  let id_csr_addr: u12 = as_u(id_word[31:20])
  let id_lui: bit = id_op == 55
  let id_auipc: bit = id_op == 23
  let id_jal: bit = id_op == 111
  let id_jalr: bit = id_op == 103 && id_f3 == 0
  let id_branch: bit = id_op == 99 && (id_f3 == 0 || id_f3 == 1 || id_f3 == 4 || id_f3 == 5 || id_f3 == 6 || id_f3 == 7)
  let id_load: bit = id_op == 3 && (id_f3 == 0 || id_f3 == 1 || id_f3 == 2 || id_f3 == 4 || id_f3 == 5)
  let id_store: bit = id_op == 35 && (id_f3 == 0 || id_f3 == 1 || id_f3 == 2)
  let id_opimm: bit = id_op == 19 && (id_f3 == 0 || id_f3 == 2 || id_f3 == 3 || id_f3 == 4 || id_f3 == 6 || id_f3 == 7 || id_f3 == 1 && id_f7 == 0 || id_f3 == 5 && (id_f7 == 0 || id_f7 == 32))
  let id_opreg: bit = id_op == 51 && (id_f7 == 0 || id_f7 == 32 && (id_f3 == 0 || id_f3 == 5))
  let id_fence: bit = id_op == 15 && id_f3 == 0
  let id_ecall: bit = id_word == 115
  let id_ebreak: bit = id_word == 1048691
  let id_mret: bit = id_word == 807403635
  let id_csr: bit = id_op == 115 && (id_f3 == 1 || id_f3 == 2 || id_f3 == 3 || id_f3 == 5 || id_f3 == 6 || id_f3 == 7)
  let id_xdot: bit = ENABLE_XNEBULA == 1 && id_op == 11 && id_f3 == 0 && id_f7 == 0
  let id_uses_a: bit = id_opimm || id_opreg || id_load || id_store || id_branch || id_jalr || id_xdot || id_csr && !id_word[14]
  let id_uses_b: bit = id_opreg || id_store || id_branch || id_xdot
  let id_csr_known: bit = id_csr_addr == 768 || id_csr_addr == 769 || id_csr_addr == 773 || id_csr_addr == 832 || id_csr_addr == 833 || id_csr_addr == 834 || id_csr_addr == 835 || id_csr_addr == 3860
  let id_csr_ro: bit = id_csr_addr == 769 || id_csr_addr == 3860
  let id_csr_wintent: bit = id_csr && (id_f3 == 1 || id_f3 == 5 || id_rs1 != 0)
  let id_csr_bad: bit = id_csr && (!id_csr_known || id_csr_ro && id_csr_wintent)
  let id_legal: bit = (id_lui || id_auipc || id_jal || id_jalr || id_branch || id_load || id_store || id_opimm || id_opreg || id_fence || id_ecall || id_ebreak || id_mret || id_csr || id_xdot) && !id_csr_bad
  let id_decode_fault: bit = !id_legal || id_ecall || id_ebreak
  let id_decode_cause: u32 = !id_legal ? 2 : id_ebreak ? 3 : 11
  let id_decode_tval: u32 = !id_legal ? id_word : 0
  let ex_op: u7 = as_u(ex_insn[6:0])
  let ex_f3: u3 = as_u(ex_insn[14:12])
  let ex_f7: u7 = as_u(ex_insn[31:25])
  let ex_rs1: u5 = as_u(ex_insn[19:15])
  let ex_rs2: u5 = as_u(ex_insn[24:20])
  let ex_rd: u5 = as_u(ex_insn[11:7])
  let ex_csr_addr: u12 = as_u(ex_insn[31:20])
  let ex_imm_i: u32 = as_u(sext(ex_insn[31:20], 32))
  let ex_imm_s: u32 = as_u(sext({ex_insn[31:25], ex_insn[11:7]}, 32))
  let ex_imm_b: u32 = as_u(sext({ex_insn[31], ex_insn[7], ex_insn[30:25], ex_insn[11:8], 1'b0}, 32))
  let ex_imm_u: u32 = as_u({ex_insn[31:12], 12'h000})
  let ex_imm_j: u32 = as_u(sext({ex_insn[31], ex_insn[19:12], ex_insn[20], ex_insn[30:21], 1'b0}, 32))
  let ex_lui: bit = ex_op == 55
  let ex_auipc: bit = ex_op == 23
  let ex_jal: bit = ex_op == 111
  let ex_jalr: bit = ex_op == 103 && ex_f3 == 0
  let ex_branch: bit = ex_op == 99 && (ex_f3 == 0 || ex_f3 == 1 || ex_f3 == 4 || ex_f3 == 5 || ex_f3 == 6 || ex_f3 == 7)
  let ex_load: bit = ex_op == 3 && (ex_f3 == 0 || ex_f3 == 1 || ex_f3 == 2 || ex_f3 == 4 || ex_f3 == 5)
  let ex_store: bit = ex_op == 35 && (ex_f3 == 0 || ex_f3 == 1 || ex_f3 == 2)
  let ex_opimm: bit = ex_op == 19 && (ex_f3 == 0 || ex_f3 == 2 || ex_f3 == 3 || ex_f3 == 4 || ex_f3 == 6 || ex_f3 == 7 || ex_f3 == 1 && ex_f7 == 0 || ex_f3 == 5 && (ex_f7 == 0 || ex_f7 == 32))
  let ex_opreg: bit = ex_op == 51 && (ex_f7 == 0 || ex_f7 == 32 && (ex_f3 == 0 || ex_f3 == 5))
  let ex_mret: bit = ex_insn == 807403635
  let ex_csr: bit = ex_op == 115 && (ex_f3 == 1 || ex_f3 == 2 || ex_f3 == 3 || ex_f3 == 5 || ex_f3 == 6 || ex_f3 == 7)
  let ex_xdot: bit = ENABLE_XNEBULA == 1 && ex_op == 11 && ex_f3 == 0 && ex_f7 == 0
  let ex_uses_a: bit = ex_opimm || ex_opreg || ex_load || ex_store || ex_branch || ex_jalr || ex_xdot || ex_csr && !ex_insn[14]
  let ex_uses_b: bit = ex_opreg || ex_store || ex_branch || ex_xdot
  let ex_csr_wintent: bit = ex_csr && (ex_f3 == 1 || ex_f3 == 5 || ex_rs1 != 0)
  let ex_rd_intent: bit = ex_lui || ex_auipc || ex_jal || ex_jalr || ex_load || ex_opimm || ex_opreg || ex_csr || ex_xdot
  let wb_trap: bit = rst_n && wb_v && wb_fault
  let wb_normal: bit = rst_n && wb_v && !wb_fault
  let wb_return: bit = wb_normal && wb_mret
  let wb_flush: bit = wb_trap || wb_return
  let wb_rf_write: bit = wb_normal && wb_rd_write && wb_rd != 0
  rf0' = 0
  rf1' = priority {
    wb_rf_write && wb_rd == 1 -> wb_result
    else -> hold
  }
  rf2' = priority {
    wb_rf_write && wb_rd == 2 -> wb_result
    else -> hold
  }
  rf3' = priority {
    wb_rf_write && wb_rd == 3 -> wb_result
    else -> hold
  }
  rf4' = priority {
    wb_rf_write && wb_rd == 4 -> wb_result
    else -> hold
  }
  rf5' = priority {
    wb_rf_write && wb_rd == 5 -> wb_result
    else -> hold
  }
  rf6' = priority {
    wb_rf_write && wb_rd == 6 -> wb_result
    else -> hold
  }
  rf7' = priority {
    wb_rf_write && wb_rd == 7 -> wb_result
    else -> hold
  }
  rf8' = priority {
    wb_rf_write && wb_rd == 8 -> wb_result
    else -> hold
  }
  rf9' = priority {
    wb_rf_write && wb_rd == 9 -> wb_result
    else -> hold
  }
  rf10' = priority {
    wb_rf_write && wb_rd == 10 -> wb_result
    else -> hold
  }
  rf11' = priority {
    wb_rf_write && wb_rd == 11 -> wb_result
    else -> hold
  }
  rf12' = priority {
    wb_rf_write && wb_rd == 12 -> wb_result
    else -> hold
  }
  rf13' = priority {
    wb_rf_write && wb_rd == 13 -> wb_result
    else -> hold
  }
  rf14' = priority {
    wb_rf_write && wb_rd == 14 -> wb_result
    else -> hold
  }
  rf15' = priority {
    wb_rf_write && wb_rd == 15 -> wb_result
    else -> hold
  }
  rf16' = priority {
    wb_rf_write && wb_rd == 16 -> wb_result
    else -> hold
  }
  rf17' = priority {
    wb_rf_write && wb_rd == 17 -> wb_result
    else -> hold
  }
  rf18' = priority {
    wb_rf_write && wb_rd == 18 -> wb_result
    else -> hold
  }
  rf19' = priority {
    wb_rf_write && wb_rd == 19 -> wb_result
    else -> hold
  }
  rf20' = priority {
    wb_rf_write && wb_rd == 20 -> wb_result
    else -> hold
  }
  rf21' = priority {
    wb_rf_write && wb_rd == 21 -> wb_result
    else -> hold
  }
  rf22' = priority {
    wb_rf_write && wb_rd == 22 -> wb_result
    else -> hold
  }
  rf23' = priority {
    wb_rf_write && wb_rd == 23 -> wb_result
    else -> hold
  }
  rf24' = priority {
    wb_rf_write && wb_rd == 24 -> wb_result
    else -> hold
  }
  rf25' = priority {
    wb_rf_write && wb_rd == 25 -> wb_result
    else -> hold
  }
  rf26' = priority {
    wb_rf_write && wb_rd == 26 -> wb_result
    else -> hold
  }
  rf27' = priority {
    wb_rf_write && wb_rd == 27 -> wb_result
    else -> hold
  }
  rf28' = priority {
    wb_rf_write && wb_rd == 28 -> wb_result
    else -> hold
  }
  rf29' = priority {
    wb_rf_write && wb_rd == 29 -> wb_result
    else -> hold
  }
  rf30' = priority {
    wb_rf_write && wb_rd == 30 -> wb_result
    else -> hold
  }
  rf31' = priority {
    wb_rf_write && wb_rd == 31 -> wb_result
    else -> hold
  }
  let id_rf1: u32 = id_rs1 == 0 ? 0 : wb_rf_write && wb_rd == id_rs1 ? wb_result : id_rs1 == 1 ? rf1 : id_rs1 == 2 ? rf2 : id_rs1 == 3 ? rf3 : id_rs1 == 4 ? rf4 : id_rs1 == 5 ? rf5 : id_rs1 == 6 ? rf6 : id_rs1 == 7 ? rf7 : id_rs1 == 8 ? rf8 : id_rs1 == 9 ? rf9 : id_rs1 == 10 ? rf10 : id_rs1 == 11 ? rf11 : id_rs1 == 12 ? rf12 : id_rs1 == 13 ? rf13 : id_rs1 == 14 ? rf14 : id_rs1 == 15 ? rf15 : id_rs1 == 16 ? rf16 : id_rs1 == 17 ? rf17 : id_rs1 == 18 ? rf18 : id_rs1 == 19 ? rf19 : id_rs1 == 20 ? rf20 : id_rs1 == 21 ? rf21 : id_rs1 == 22 ? rf22 : id_rs1 == 23 ? rf23 : id_rs1 == 24 ? rf24 : id_rs1 == 25 ? rf25 : id_rs1 == 26 ? rf26 : id_rs1 == 27 ? rf27 : id_rs1 == 28 ? rf28 : id_rs1 == 29 ? rf29 : id_rs1 == 30 ? rf30 : id_rs1 == 31 ? rf31 : 0
  let id_rf2: u32 = id_rs2 == 0 ? 0 : wb_rf_write && wb_rd == id_rs2 ? wb_result : id_rs2 == 1 ? rf1 : id_rs2 == 2 ? rf2 : id_rs2 == 3 ? rf3 : id_rs2 == 4 ? rf4 : id_rs2 == 5 ? rf5 : id_rs2 == 6 ? rf6 : id_rs2 == 7 ? rf7 : id_rs2 == 8 ? rf8 : id_rs2 == 9 ? rf9 : id_rs2 == 10 ? rf10 : id_rs2 == 11 ? rf11 : id_rs2 == 12 ? rf12 : id_rs2 == 13 ? rf13 : id_rs2 == 14 ? rf14 : id_rs2 == 15 ? rf15 : id_rs2 == 16 ? rf16 : id_rs2 == 17 ? rf17 : id_rs2 == 18 ? rf18 : id_rs2 == 19 ? rf19 : id_rs2 == 20 ? rf20 : id_rs2 == 21 ? rf21 : id_rs2 == 22 ? rf22 : id_rs2 == 23 ? rf23 : id_rs2 == 24 ? rf24 : id_rs2 == 25 ? rf25 : id_rs2 == 26 ? rf26 : id_rs2 == 27 ? rf27 : id_rs2 == 28 ? rf28 : id_rs2 == 29 ? rf29 : id_rs2 == 30 ? rf30 : id_rs2 == 31 ? rf31 : 0
  let csr_serial_busy: bit = ex_v && (ex_csr || ex_mret) || mem_v && (mem_csr_write || mem_mret || mem_insn[6:0] == 7'h73) || wb_v && wb_insn[6:0] == 7'h73
  let id_serial_wait: bit = if_v && (id_csr || id_mret) && (ex_v || mem_v || wb_v)
  let mem_is_memory: bit = mem_load || mem_store
  dmem_req_valid = rst_n && mem_v && mem_is_memory && !mem_fault && !mem_sent && !wb_flush
  dmem_req_write = dmem_req_valid && mem_store
  dmem_req_addr = rst_n ? mem_bus_addr : 0
  dmem_req_wdata = rst_n ? mem_bus_data : 0
  dmem_req_wstrb = rst_n ? mem_bus_mask : 0
  dmem_rsp_ready = rst_n && mem_v && mem_is_memory && !mem_fault && mem_sent && !wb_flush
  let mem_req_fire: bit = dmem_req_valid && dmem_req_ready
  let mem_rsp_fire: bit = dmem_rsp_valid && dmem_rsp_ready
  let mem_error: bit = mem_rsp_fire && dmem_rsp_err
  let mem_advance: bit = rst_n && mem_v && !wb_flush && (!mem_is_memory || mem_fault || mem_rsp_fire)
  let mem_available: bit = !mem_v || mem_advance
  let mem_known_fault: bit = mem_v && mem_fault
  let mem_lane_shift: u32 = zext(as_u(mem_ea[1:0]), 32) << 3
  let mem_shifted: u32 = dmem_rsp_rdata >> mem_lane_shift
  let mem_load_result: u32 = mem_f3 == 0 ? as_u(sext(mem_shifted[7:0], 32)) : mem_f3 == 1 ? as_u(sext(mem_shifted[15:0], 32)) : mem_f3 == 4 ? as_u(zext(mem_shifted[7:0], 32)) : mem_f3 == 5 ? as_u(zext(mem_shifted[15:0], 32)) : dmem_rsp_rdata
  let mem_completed_result: u32 = mem_load ? mem_load_result : mem_result
  let mem_can_forward: bit = mem_v && !mem_fault && !mem_error && mem_rd_write && mem_rd != 0 && (!mem_load || mem_rsp_fire)
  let ex_a_mem_match: bit = ex_uses_a && ex_rs1 != 0 && mem_v && !mem_fault && mem_rd_write && mem_rd == ex_rs1
  let ex_a_blocked: bit = ex_a_mem_match && !mem_can_forward
  let ex_a: u32 = ex_rs1 == 0 ? 0 : ex_a_mem_match && mem_can_forward ? mem_completed_result : wb_rf_write && wb_rd == ex_rs1 ? wb_result : ex_a_snap
  let ex_b_mem_match: bit = ex_uses_b && ex_rs2 != 0 && mem_v && !mem_fault && mem_rd_write && mem_rd == ex_rs2
  let ex_b_blocked: bit = ex_b_mem_match && !mem_can_forward
  let ex_b: u32 = ex_rs2 == 0 ? 0 : ex_b_mem_match && mem_can_forward ? mem_completed_result : wb_rf_write && wb_rd == ex_rs2 ? wb_result : ex_b_snap
  let ex_operands_ready: bit = !ex_a_blocked && !ex_b_blocked
  let ex_alu_b: u32 = ex_opimm ? ex_imm_i : ex_b
  let ex_shamt: u5 = as_u(ex_alu_b[4:0])
  let ex_alu: u32 = ex_f3 == 0 ? ex_opreg && ex_f7 == 32 ? ex_a - ex_alu_b : ex_a + ex_alu_b : ex_f3 == 1 ? ex_a << zext(ex_shamt, 32) : ex_f3 == 2 ? as_s(ex_a) < as_s(ex_alu_b) ? 32'd1 : 32'd0 : ex_f3 == 3 ? ex_a < ex_alu_b ? 32'd1 : 32'd0 : ex_f3 == 4 ? ex_a ^ ex_alu_b : ex_f3 == 5 ? ex_f7 == 32 ? as_u(as_s(ex_a) >> zext(ex_shamt, 32)) : ex_a >> zext(ex_shamt, 32) : ex_f3 == 6 ? ex_a | ex_alu_b : ex_a & ex_alu_b
  let ex_ea: u32 = ex_a + (ex_store ? ex_imm_s : ex_imm_i)
  let ex_lane_shift: u32 = zext(as_u(ex_ea[1:0]), 32) << 3
  let ex_bus_addr: u32 = ex_ea & 32'hfffffffc
  let ex_bus_mask: u4 = ex_store && ex_f3 == 0 ? as_u(4'h1) << zext(as_u(ex_ea[1:0]), 4) : ex_store && ex_f3 == 1 ? as_u(4'h3) << zext(as_u(ex_ea[1:0]), 4) : ex_store && ex_f3 == 2 ? 4'hf : 0
  let ex_bus_data: u32 = ex_store && ex_f3 == 0 ? (ex_b & 32'hff) << ex_lane_shift : ex_store && ex_f3 == 1 ? (ex_b & 32'hffff) << ex_lane_shift : ex_store && ex_f3 == 2 ? ex_b : 0
  let ex_mem_misaligned: bit = (ex_load || ex_store) && ((ex_f3 == 1 || ex_f3 == 5) && ex_ea[0] || ex_f3 == 2 && ex_ea[1:0] != 2'b00)
  let ex_branch_taken: bit = ex_branch && (ex_f3 == 0 ? ex_a == ex_b : ex_f3 == 1 ? ex_a != ex_b : ex_f3 == 4 ? as_s(ex_a) < as_s(ex_b) : ex_f3 == 5 ? as_s(ex_a) >= as_s(ex_b) : ex_f3 == 6 ? ex_a < ex_b : ex_a >= ex_b)
  let ex_control_taken: bit = ex_jal || ex_jalr || ex_branch_taken
  let ex_target: u32 = ex_jalr ? ex_a + ex_imm_i & 32'hfffffffe : ex_pc + (ex_jal ? ex_imm_j : ex_imm_b)
  let ex_target_bad: bit = ex_control_taken && ex_target[1:0] != 2'b00
  let ex_final_fault: bit = ex_fault || ex_mem_misaligned || ex_target_bad
  let ex_final_cause: u32 = ex_fault ? ex_cause : ex_mem_misaligned ? ex_store ? 6 : 4 : 0
  let ex_final_tval: u32 = ex_fault ? ex_tval : ex_mem_misaligned ? ex_ea : ex_target
  let ex_csr_old: u32 = ex_csr_addr == 768 ? mstatus : ex_csr_addr == 773 ? mtvec : ex_csr_addr == 832 ? mscratch : ex_csr_addr == 833 ? mepc : ex_csr_addr == 834 ? mcause : ex_csr_addr == 835 ? mtval : ex_csr_addr == 769 ? 32'h40000100 : 0
  let ex_csr_source: u32 = ex_insn[14] ? zext(ex_rs1, 32) : ex_a
  let ex_csr_new: u32 = ex_f3 == 1 || ex_f3 == 5 ? ex_csr_source : ex_f3 == 2 || ex_f3 == 6 ? ex_csr_old | ex_csr_source : ex_csr_old & ~ex_csr_source
  let npu_kill: bit = !rst_n || wb_flush || mem_error || mem_known_fault
  let ex_eligible: bit = rst_n && ex_v && !wb_flush && !mem_error && !mem_known_fault && mem_available && ex_operands_ready
  let npu_req_valid: bit = ex_eligible && ex_xdot && !ex_final_fault && !xdot_issued && !npu_kill
  let npu_rsp_ready: bit = ex_eligible && ex_xdot && xdot_issued && !ex_final_fault && !npu_kill
  state np_phase: {IDLE,P0,P1,RSP} @core reset IDLE
  state np_p0: s16 @core reset 0
  state np_p1: s16 @core reset 0
  state np_p2: s16 @core reset 0
  state np_p3: s16 @core reset 0
  state np_pair0: s17 @core reset 0
  state np_pair1: s17 @core reset 0
  state np_result: s32 @core reset 0
  let np_req_ready: bit = rst_n && !npu_kill && np_phase == IDLE
  let np_rsp_valid: bit = rst_n && !npu_kill && np_phase == RSP
  let np_rsp_data: u32 = rst_n ? as_u(np_result) : 0
  let np_req_fire: bit = npu_req_valid && np_req_ready
  let np_rsp_fire: bit = np_rsp_valid && npu_rsp_ready
  np_phase' = priority {
    npu_kill -> IDLE
    np_req_fire -> P0
    np_phase == P0 -> P1
    np_phase == P1 -> RSP
    np_rsp_fire -> IDLE
    else -> hold
  }
  np_p0' = priority {
    npu_kill -> 0
    np_req_fire -> sext(as_s(ex_a[7:0]), 16) * sext(as_s(ex_b[7:0]), 16)
    else -> hold
  }
  np_p1' = priority {
    npu_kill -> 0
    np_req_fire -> sext(as_s(ex_a[15:8]), 16) * sext(as_s(ex_b[15:8]), 16)
    else -> hold
  }
  np_p2' = priority {
    npu_kill -> 0
    np_req_fire -> sext(as_s(ex_a[23:16]), 16) * sext(as_s(ex_b[23:16]), 16)
    else -> hold
  }
  np_p3' = priority {
    npu_kill -> 0
    np_req_fire -> sext(as_s(ex_a[31:24]), 16) * sext(as_s(ex_b[31:24]), 16)
    else -> hold
  }
  np_pair0' = priority {
    npu_kill -> 0
    np_phase == P0 -> sext(np_p0, 17) + sext(np_p1, 17)
    else -> hold
  }
  np_pair1' = priority {
    npu_kill -> 0
    np_phase == P0 -> sext(np_p2, 17) + sext(np_p3, 17)
    else -> hold
  }
  np_result' = priority {
    npu_kill -> 0
    np_phase == P1 -> sext(sext(np_pair0, 18) + sext(np_pair1, 18), 32)
    else -> hold
  }
  assert @core np_req_fire |=> np_phase == P0 unless !rst_n || npu_kill
  assert @core np_phase == P0 |=> np_phase == P1 unless !rst_n || npu_kill
  assert @core np_phase == P1 |=> np_phase == RSP unless !rst_n || npu_kill
  assert @core np_rsp_valid && !npu_rsp_ready |=> np_rsp_valid && np_rsp_data == past(np_rsp_data, 1) unless !rst_n || npu_kill
  assert @core always !(np_req_ready && np_rsp_valid) unless !rst_n || npu_kill
  let ex_advance: bit = ex_eligible && (!ex_xdot || ex_final_fault || np_rsp_fire)
  let ex_redirect: bit = ex_advance && !ex_final_fault && ex_control_taken
  let ex_fault_selected: bit = ex_advance && ex_final_fault
  let front_flush: bit = wb_flush || mem_error || mem_known_fault || ex_redirect || ex_fault_selected
  let id_load_use: bit = if_v && ex_v && ex_load && !ex_fault && ex_rd != 0 && (id_uses_a && id_rs1 == ex_rd || id_uses_b && id_rs2 == ex_rd)
  let id_advance: bit = rst_n && if_v && (!ex_v || ex_advance) && !front_flush && !id_load_use && !csr_serial_busy && !id_serial_wait
  let fetch_block: bit = front_flush || csr_serial_busy || if_v && id_decode_fault || ex_v && ex_fault || ex_v && ex_xdot && !ex_advance || id_serial_wait
  let fetch_room: bit = !if_v || id_advance
  imem_valid = rst_n && fetch_room && !fetch_block && fetch_pc[1:0] == 2'b00
  imem_addr = rst_n ? fetch_pc : 0
  let fetch_fire: bit = imem_valid
  let fetch_bad: bit = rst_n && fetch_room && !fetch_block && fetch_pc[1:0] != 2'b00
  state if_fault: bit @core reset 0
  fetch_pc' = priority {
    wb_trap -> mtvec
    wb_return -> mepc
    ex_redirect -> ex_target
    fetch_fire -> fetch_pc + 4
    else -> hold
  }
  if_v' = priority {
    front_flush -> 0
    fetch_fire || fetch_bad -> 1
    id_advance -> 0
    else -> hold
  }
  if_pc' = priority {
    front_flush -> 0
    fetch_fire || fetch_bad -> fetch_pc
    else -> hold
  }
  if_fault' = priority {
    front_flush -> 0
    fetch_fire || fetch_bad -> fetch_bad
    id_advance -> 0
    else -> hold
  }
  if_held' = priority {
    front_flush || fetch_fire || fetch_bad || id_advance -> 0
    if_v && !if_held -> 1
    else -> hold
  }
  if_word' = priority {
    front_flush -> 0
    if_v && !if_held && !id_advance -> imem_rdata
    else -> hold
  }
  ex_v' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> 1
    ex_advance -> 0
    else -> hold
  }
  ex_pc' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> if_pc
    else -> hold
  }
  ex_insn' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> id_word
    else -> hold
  }
  ex_fault' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> if_fault || id_decode_fault
    else -> hold
  }
  ex_cause' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> if_fault ? 0 : id_decode_cause
    else -> hold
  }
  ex_tval' = priority {
    wb_flush || mem_error || mem_known_fault -> 0
    id_advance -> if_fault ? if_pc : id_decode_tval
    else -> hold
  }
  ex_a_snap' = priority {
    wb_flush || mem_error || mem_known_fault -> 0

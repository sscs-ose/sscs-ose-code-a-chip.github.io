  assume @core dmem_rsp_valid && !dmem_rsp_ready |=> dmem_rsp_valid && dmem_rsp_rdata == past(dmem_rsp_rdata, 1) && dmem_rsp_err == past(dmem_rsp_err, 1) unless !rst_n

  wb_rd' = priority {
    mem_advance -> mem_rd
    else -> 0
  }
  wb_rd_write' = priority {
    mem_advance -> mem_rd_write && !mem_fault && !mem_error
    else -> 0
  }
  wb_result' = priority {
    mem_advance -> mem_completed_result
    else -> 0
  }
  wb_store' = priority {
    mem_advance -> mem_store && !mem_fault && !mem_error
    else -> 0
  }
  wb_bus_addr' = priority {
    mem_advance -> mem_bus_addr
    else -> 0
  }
  wb_bus_data' = priority {
    mem_advance -> mem_bus_data
    else -> 0
  }
  wb_bus_mask' = priority {
    mem_advance -> mem_bus_mask
    else -> 0
  }
  wb_csr_write' = priority {
    mem_advance -> mem_csr_write && !mem_fault && !mem_error
    else -> 0
  }
  wb_csr_addr' = priority {
    mem_advance -> mem_csr_addr
    else -> 0
  }
  wb_csr_new' = priority {
    mem_advance -> mem_csr_new
    else -> 0

    clk: clk
    rst_n: rst_n
    imem_valid: imem_valid
    imem_addr: imem_addr
    imem_rdata: imem_rdata
    dmem_req_valid: dmem_req_valid
    dmem_req_ready: dmem_req_ready
    dmem_req_write: dmem_req_write

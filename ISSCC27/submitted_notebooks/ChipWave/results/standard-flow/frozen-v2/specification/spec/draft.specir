module nebula_cpu_npu_top {
  in clk: bit
  in rst_n: bit
  abstract out imem_valid: bit
  abstract out imem_addr: u32
  in imem_rdata: u32
  abstract out dmem_req_valid: bit
  in dmem_req_ready: bit
  abstract out dmem_req_write: bit
  abstract out dmem_req_addr: u32
  abstract out dmem_req_wdata: u32
  abstract out dmem_req_wstrb: u4
  in dmem_rsp_valid: bit
  abstract out dmem_rsp_ready: bit
  in dmem_rsp_rdata: u32
  in dmem_rsp_err: bit
  abstract out commit_valid: bit
  abstract out commit_pc: u32

  "brief": {
    "objective": "Deliver a fully routed, extracted and physically closed implementation of the frozen mapped netlist and constraints.",
    "deliverables": [
      "layout: layout@1 under build/pnr/** and reports/pnr/**, including final database, post-route netlist, SPEF/SDF and stage evidence.",
      "EDA result summary, execution/connectivity/antenna evidence and reports/pnr/post_route_export_consistency.json.",
      "Required rolling checkpoints and acceptance-required synthesis/equivalence receipts."
    ],
    "responsibilities": [
      "Follow openroad-physical-closure and the installed ORFS ordering and output contracts.",
      "Complete floorplan, placement, CTS, routing and extraction; preserve prescribed two-slot recoverable checkpoints.",
      "Bind independent STA and export-consistency evidence to the same final database/netlist/parasitics; satisfy acceptance-required equivalence."
    ],
    "exclusions": [
      "No input-netlist, constraint or foundry-view edits; no hidden violations or relaxed thresholds.",
      "No formal tapeout-release claim."
    ],
    "completion_criteria": [
      "pnr-result-summary passes with measured die area, setup/hold slack, DRC and antenna counts.",
      "post-route-export-consistency passes at the declared 1e-06 threshold.",
      "post-route-setup-closure and post-route-hold-closure establish slack >= 0.",
      "detailed-route-drc-clean and antenna-clean establish violations <= 0; final connectivity is clean.",
      "execution-status finds reports/pnr/execution_status.json, whose status and direct evidence establish completed successful execution."
    ],
    "collaboration": [
      "task:standard-cpu-npu:failure-analysis",
      "task:standard-cpu-npu:freeze-acceptance-plan",
      "task:standard-cpu-npu:freeze-project-constraints",
      "task:standard-cpu-npu:gds-export",
      "task:standard-cpu-npu:synthesize"
    ]
  },

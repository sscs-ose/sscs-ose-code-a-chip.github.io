module benchmark_counter {
  in clk: bit
  in rst_n: bit
  in en: bit
  in load: bit
  in load_value: u16
  abstract out count: u16
  abstract out overflow: bit
  apply behavior {
    clk: clk
    rst_n: rst_n
    en: en
    load: load
    load_value: load_value
    count: count
    overflow: overflow
  }
}

  "requirements": [
    {
      "id": "REQ-BEHAVIOR",
      "classification": "normative",
      "status": "mapped",
      "mapping_kind": "both",
      "text": "Implement benchmark_fifo, 4 entries of 8 bits, one rising-edge clock.\nActive-low asynchronous reset makes the FIFO empty. Read data is the current\nhead combinationally, and zero when empty. full/empty reflect current occupancy.\nAt an edge, accept push iff wr_en && !full; accept pop iff rd_en && !empty,\nusing flags BEFORE the edge. Thus simultaneous read/write on full accepts only\nthe read; on empty accepts only the write. No fall-through, overwrite or underflow.\nPreserve exact insertion order. Memory reset is not required; externally visible\noutputs after reset must meet the empty/zero contract.",
      "evidence": [
        "task.md"
      ],

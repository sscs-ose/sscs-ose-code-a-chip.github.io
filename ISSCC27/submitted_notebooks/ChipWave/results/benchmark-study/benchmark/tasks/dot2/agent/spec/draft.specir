module benchmark_dot {
  in clk: bit
  in rst_n: bit
  in req_valid: bit
  abstract out req_ready: bit
  in req_a: u16
  in req_b: u16
  abstract out rsp_valid: bit
  in rsp_ready: bit
  abstract out rsp_data: u32
  in kill: bit
  apply behavior {
    clk: clk
    rst_n: rst_n
    req_valid: req_valid
    req_ready: req_ready
    req_a: req_a
    req_b: req_b
    rsp_valid: rsp_valid
    rsp_ready: rsp_ready
    rsp_data: rsp_data
    kill: kill
  }
}

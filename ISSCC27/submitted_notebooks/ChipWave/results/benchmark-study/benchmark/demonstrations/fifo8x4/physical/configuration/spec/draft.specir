module benchmark_fifo {
  in clk: bit
  in rst_n: bit
  in wr_en: bit
  in rd_en: bit
  in wr_data: u8
  abstract out rd_data: u8
  abstract out full: bit
  abstract out empty: bit
  apply behavior {
    clk: clk
    rst_n: rst_n
    wr_en: wr_en
    rd_en: rd_en
    wr_data: wr_data
    rd_data: rd_data
    full: full
    empty: empty
  }
}

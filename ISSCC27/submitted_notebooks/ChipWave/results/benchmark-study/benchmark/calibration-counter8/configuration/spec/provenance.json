  "requirements": [
    {
      "id": "REQ-BEHAVIOR",
      "classification": "normative",
      "status": "mapped",
      "mapping_kind": "both",
      "text": "Implement benchmark_counter with 8-bit unsigned count/load_value.\nActive-low asynchronous reset immediately clears count and overflow. At each\nrising edge, load has priority over en: load sets count=load_value and overflow=0.\nOtherwise en increments count modulo 2**8, with overflow=1 exactly on a wrap.\nWith neither load nor en, hold count and clear overflow. No extra clock latency.",
      "evidence": [
        "task.md"
      ],

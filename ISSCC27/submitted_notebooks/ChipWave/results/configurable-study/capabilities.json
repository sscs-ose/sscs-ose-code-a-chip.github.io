            "type": "specification.bundle",
            "from": "$tasks.generate-csir-draft.outputs.bundle"
          },
          "baseline": {
            "type": "specification.baseline",
            "from": "$tasks.freeze-specification-baseline.outputs.baseline"
          },
          "specification": {
            "type": "specification.csir",
            "from": "$tasks.freeze-specification-baseline.outputs.specification"
          }
        },
        "gates": []
      },
      {

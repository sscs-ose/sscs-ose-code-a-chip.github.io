    "tasks": [
      {
        "name": "analyze-source",
        "role": "specification-author",
        "executor": "agent",
        "inputs": {
          "source": {
            "type": "specification.source",
            "from": "$parameters.source"
          }
        },
        "gates": [
          "ledger-shape"
        ]
      },
      {
        "name": "generate-design-document",
        "role": "specification-author",
        "executor": "agent",
        "inputs": {
          "source": {
            "type": "specification.source",
            "from": "$parameters.source"
          },
          "analysis": {
            "type": "specification.source-analysis",
            "from": "$tasks.analyze-source.outputs.analysis"
          }
        },
        "gates": []
      },
      {
        "name": "generate-csir-draft",
        "role": "specification-author",
        "executor": "agent",
        "inputs": {
          "source": {
            "type": "specification.source",
            "from": "$parameters.source"
          },
          "analysis": {
            "type": "specification.source-analysis",
            "from": "$tasks.analyze-source.outputs.analysis"
          },
          "design": {
            "type": "design.specification",
            "from": "$tasks.generate-design-document.outputs.design"
          }
        },
        "gates": [
          "ledger-status-protection"
        ]
      },
      {
        "name": "review-requirements-closure",
        "role": "requirements-closure-reviewer",
        "executor": "agent",
        "inputs": {
          "source": {
            "type": "specification.source",
            "from": "$parameters.source"
          },
          "analysis": {
            "type": "specification.source-analysis",
            "from": "$tasks.analyze-source.outputs.analysis"
          },
          "design": {
            "type": "design.specification",
            "from": "$tasks.generate-design-document.outputs.design"
          },
          "bundle": {
            "type": "specification.bundle",
            "from": "$tasks.generate-csir-draft.outputs.bundle"
          }
        },
        "gates": [
          "review-integrity",
          "requirements-closure"
        ]
      },
      {
        "name": "spec-compiler",
        "role": "spec-compiler",
        "executor": "tool",
        "inputs": {
          "bundle": {
            "type": "specification.bundle",
            "from": "$tasks.generate-csir-draft.outputs.bundle"
          },
          "review": {
            "type": "requirements.review.report",
            "from": "$tasks.review-requirements-closure.outputs.review",
            "release": {
              "field": "verdict",
              "equals": "passed"
            }
          }
        },
        "gates": []
      },
      {
        "name": "consolidate-spec-decisions",
        "role": "project-decision-consolidator",
        "executor": "agent",
        "inputs": {},
        "gates": []
      },
      {
        "name": "freeze-specification-baseline",
        "role": "specification-readiness-auditor",
        "executor": "tool",
        "inputs": {
          "bundle": {
            "type": "specification.bundle",
            "from": "$tasks.generate-csir-draft.outputs.bundle"
          },
          "review": {
            "type": "requirements.review.report",
            "from": "$tasks.review-requirements-closure.outputs.review",
            "release": {
              "field": "verdict",
              "equals": "passed"
            }
          },
          "compiler_result": {
            "type": "spec.compiler.report",
            "from": "$tasks.spec-compiler.outputs.result",
            "release": {
              "field": "failure_kind",
              "equals": ""
            }
          }
        },
        "gates": []
      },
      {
        "name": "propose-project-constraint-decisions",

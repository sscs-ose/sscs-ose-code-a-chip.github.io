** sch_path: /home/gokalp/projects/PerfPDN/output/submission/20261030_205357/PerfPDN/examples/inverter_amplifier/inverter_access_tb.sch
**.subckt inverter_access_tb
C1 out GND 100f m=1
Vdd vdd GND 1.8
Vin in GND dc 0.89 ac 1 sin(0.89 1m 10Meg)
x1 vdd in out GND inv
**** begin user architecture code

.lib /home/gokalp/.local/share/perfpdn/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice tt



.option scale=1e-6
.temp 27
.control
set wr_singlescale
set wr_vecnames
op
print v(in) v(out) i(Vdd)
ac dec 50 1k 100G
let gain_db=db(v(out))
wrdata analog_ac.txt gain_db
tran 500p 600n
let isupply=-i(Vdd)
meas tran iavg AVG isupply from=400n to=600n
wrdata analog_signal.txt v(in) v(out) isupply
.endc


**** end user architecture code
**.ends

